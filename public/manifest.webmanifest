{
  "id": "./",
  "name": "PDF Studio",
  "short_name": "PDF Studio",
  "description": "Private browser-local PDF viewing, editing, OCR, security, compression, conversion, and professional document tools.",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#111418",
  "theme_color": "#111418",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "files",
        "accept": ["application/pdf", ".pdf", "application/x-local-pdf-studio-project", ".lpsproject"]
      }]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "application/x-local-pdf-studio-project": [".lpsproject"]
      }
    }
  ],
  "shortcuts": [
    { "name": "Open projects", "short_name": "Projects", "url": "./#/projects" },
    { "name": "Quick Tools", "short_name": "Tools", "url": "./#/tools" },
    { "name": "Scan to PDF", "short_name": "Scan", "url": "./#/scan" },
    { "name": "Validate this build", "short_name": "Validate", "url": "./#/validation" },
    { "name": "Help and recovery", "short_name": "Help", "url": "./#/help" }
  ],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
