{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "src/core/coordinates.ts",
    "src/core/appRouter.ts",
    "src/organizer/pageSelection.ts",
    "src/organizer/pagePlan.ts",
    "src/activity/activityModel.ts",
    "src/workspace/preservationContracts.ts",
    "src/types/workspace.ts",
    "src/types/organizer.ts"
  ]
}
